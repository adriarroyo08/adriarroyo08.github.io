---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}

const { project } = Astro.props;

const sections = [
  { titleEs: "Tecnologias", titleEn: "Technologies", textEs: project.tech, textEn: project.techEn, icon: "stack" },
  { titleEs: "Mi rol", titleEn: "My role", textEs: project.role, textEn: project.roleEn, icon: "person" },
  { titleEs: "Retos tecnicos", titleEn: "Technical challenges", textEs: project.challenges, textEn: project.challengesEn, icon: "lightning" },
  { titleEs: "Resultados", titleEn: "Results", textEs: project.results, textEn: project.resultsEn, icon: "chart" },
];
---

<Layout title={`${project.title} — Adrian Arroyo`}>
  <Navbar />

  <main class="pt-28 pb-20 px-6">
    <div class="max-w-3xl mx-auto">

      <!-- Back link top -->
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-zinc-400 hover:text-[#00ff88] transition-colors text-sm mb-8 group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:-translate-x-1">
          <path d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        <span data-i18n="project.back">Volver a proyectos</span>
      </a>

      <!-- Header -->
      <div class="mb-10">
        {project.type === "profesional" ? (
          <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/15 text-blue-400 border border-blue-500/25">
            <span data-i18n="projects.filter.profesional">Profesional</span>
          </span>
        ) : (
          <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-purple-500/15 text-purple-400 border border-purple-500/25">
            <span data-i18n="projects.filter.personal">Personal</span>
          </span>
        )}

        <h1
          class="text-3xl md:text-5xl font-extrabold mt-3 mb-4"
          data-i18n-es={project.title}
          data-i18n-en={project.titleEn}
        >
          {project.title}
        </h1>

        <!-- Tags -->
        <div class="flex flex-wrap gap-2">
          {project.tags.map((tag) => (
            <span class="px-2 py-1 rounded text-xs text-zinc-400 bg-zinc-800 border border-zinc-700">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <!-- Overview -->
      <p
        class="text-lg text-zinc-300 leading-relaxed mb-12 pb-8 border-b border-white/5"
        data-i18n-es={project.overview}
        data-i18n-en={project.overviewEn}
      >
        {project.overview}
      </p>

      <!-- Detail sections -->
      <div class="flex flex-col gap-6 mb-12">
        {sections.map((section) => (
          <div class="card p-6">
            <h2 class="text-sm font-semibold uppercase tracking-wider gradient-text mb-3"
              data-i18n-es={section.titleEs}
              data-i18n-en={section.titleEn}
            >
              {section.titleEs}
            </h2>
            <p
              class="text-zinc-300 leading-relaxed"
              data-i18n-es={section.textEs}
              data-i18n-en={section.textEn}
            >
              {section.textEs}
            </p>
          </div>
        ))}
      </div>

      <!-- Back link bottom -->
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-zinc-400 hover:text-[#00ff88] transition-colors text-sm group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:-translate-x-1">
          <path d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        <span data-i18n="project.back">Volver a proyectos</span>
      </a>

    </div>
  </main>
</Layout>

<script>
  // i18n support for bilingual fields using data-i18n-es / data-i18n-en attributes
  function applyDetailLang(lang: string) {
    const attr = lang === 'en' ? 'data-i18n-en' : 'data-i18n-es';
    document.querySelectorAll<HTMLElement>('[data-i18n-es]').forEach((el) => {
      const text = el.getAttribute(attr);
      if (text) el.textContent = text;
    });
  }

  // Read current language from localStorage (set by the i18n-client)
  const stored = localStorage.getItem('lang') ?? 'es';
  applyDetailLang(stored);

  // React to language changes dispatched by the i18n toggle
  window.addEventListener('langchange', (e: Event) => {
    const lang = (e as CustomEvent<string>).detail;
    applyDetailLang(lang);
  });
</script>
