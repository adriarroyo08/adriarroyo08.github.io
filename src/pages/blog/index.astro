---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Blog — Adrian Arroyo">
  <Navbar />
  <main class="pt-28 pb-20 px-6">
    <div class="max-w-3xl mx-auto">
      <a href="/" class="text-zinc-400 hover:text-[#00ff88] text-sm mb-8 inline-block">← Volver</a>
      <h1 class="text-4xl font-extrabold mb-3">
        <span class="gradient-text">Blog</span>
      </h1>
      <p class="text-zinc-500 mb-12">Ideas, aprendizajes y cosas que descubro</p>

      <div class="flex flex-col gap-6">
        {posts.map(post => (
          <a href={`/blog/${post.id}`} class="card p-6 block group">
            <time class="text-xs text-zinc-500">{post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            <h2 class="text-xl font-bold mt-2 mb-2 group-hover:text-[#00ff88] transition-colors">{post.data.title}</h2>
            <p class="text-zinc-400 text-sm">{post.data.description}</p>
            <div class="flex flex-wrap gap-2 mt-3">
              {post.data.tags.map(tag => (
                <span class="text-xs px-2 py-1 rounded bg-white/5 text-zinc-400">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
