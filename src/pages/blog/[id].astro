---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} — Adrian Arroyo`}>
  <Navbar />
  <main class="pt-28 pb-20 px-6">
    <article class="max-w-3xl mx-auto">
      <a href="/blog" class="text-zinc-400 hover:text-[#00ff88] text-sm mb-8 inline-block">← Volver al blog</a>
      <time class="text-xs text-zinc-500">{post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      <h1 class="text-3xl md:text-4xl font-extrabold mt-2 mb-6">{post.data.title}</h1>
      <div class="flex flex-wrap gap-2 mb-10">
        {post.data.tags.map(tag => (
          <span class="text-xs px-2 py-1 rounded bg-white/5 text-zinc-400">{tag}</span>
        ))}
      </div>
      <div class="prose prose-invert prose-green max-w-none
                  prose-headings:font-bold prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
                  prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
                  prose-p:text-zinc-300 prose-p:leading-relaxed
                  prose-li:text-zinc-300
                  prose-strong:text-white prose-strong:font-semibold
                  prose-code:text-[#00ff88] prose-code:bg-white/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
                  prose-a:text-[#00ff88] prose-a:no-underline hover:prose-a:underline">
        <Content />
      </div>
    </article>
  </main>
</Layout>
