---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Terminal from '../components/Terminal.tsx';
import ParticlesBg from '../components/ParticlesBg.tsx';
import AiSection from '../components/AiSection.astro';
import StackSection from '../components/StackSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout>
  <ParticlesBg client:load />
  <Navbar />

  <!-- HERO with Terminal -->
  <header id="hero" class="min-h-screen flex items-center justify-center px-6 pt-24 pb-16 relative">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-1/2 -left-1/2 w-[200%] h-[200%] opacity-60"
           style="background: radial-gradient(ellipse at 30% 50%, rgba(0,255,136,0.06) 0%, transparent 50%), radial-gradient(ellipse at 70% 50%, rgba(0,187,255,0.04) 0%, transparent 50%);">
      </div>
    </div>
    <div class="relative z-10 w-full max-w-3xl">
      <div class="mb-6">
        <span class="inline-block px-4 py-1.5 text-xs font-medium rounded-full border border-[#00ff88]/30 bg-[#00ff88]/10 text-[#00ff88]">
          Fullstack Developer & AI Engineer
        </span>
      </div>
      <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-6">
        Hola, soy <span class="gradient-text">Adrian Arroyo</span>
      </h1>
      <p class="text-lg text-zinc-400 mb-10 max-w-xl">
        Construyo software que escala, automatizo lo que otros hacen a mano, y colaboro con IA para ir mas rapido y mas lejos.
      </p>
      <Terminal client:load />

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 animate-bounce">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" class="text-zinc-500">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </div>
    </div>
  </header>

  <main>
    <AiSection />
    <StackSection />
    <ProjectsSection />
    <ExperienceSection />
    <ContactSection />
  </main>

  <!-- Footer -->
  <footer class="text-center py-10 border-t border-white/5">
    <p class="text-zinc-500 text-sm">
      Disenado y desarrollado por Adrian Arroyo Perez
    </p>
    <p class="text-zinc-600 text-xs mt-2">
      Built with Astro + React + Three.js + Claude Code
    </p>
  </footer>
</Layout>
