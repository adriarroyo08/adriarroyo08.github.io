---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Terminal from '../components/Terminal.tsx';
import ParticlesBg from '../components/ParticlesBg.tsx';
import AiSection from '../components/AiSection.astro';
import StackSection from '../components/StackSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import ContactSection from '../components/ContactSection.astro';
import GitHubSection from '../components/GitHubSection.astro';
---

<Layout>
  <ParticlesBg client:load />
  <Navbar />

  <!-- HERO -->
  <header id="hero" class="min-h-screen flex items-center justify-center px-6 pt-24 pb-16 relative">
    <!-- Neural background mesh -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <svg class="absolute inset-0 w-full h-full opacity-[0.03]" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="neural-grid" width="60" height="60" patternUnits="userSpaceOnUse">
            <circle cx="30" cy="30" r="1" fill="#00f0ff"/>
            <line x1="30" y1="30" x2="60" y2="0" stroke="#00f0ff" stroke-width="0.3"/>
            <line x1="30" y1="30" x2="0" y2="60" stroke="#bf5af2" stroke-width="0.3"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#neural-grid)"/>
      </svg>
    </div>

    <div class="relative z-10 w-full max-w-3xl">
      <!-- Status badge -->
      <div class="mb-8">
        <span class="inline-flex items-center gap-2 px-4 py-2 text-xs font-medium rounded-full border"
              style="border-color: rgba(0,240,255,0.2); background: rgba(0,240,255,0.05); color: #00f0ff; font-family: var(--font-mono);">
          <span class="w-2 h-2 rounded-full bg-[#39ff14] animate-pulse"></span>
          Fullstack Developer & AI Engineer
        </span>
      </div>

      <!-- Main heading -->
      <h1 class="text-5xl md:text-7xl font-extrabold leading-[1.1] mb-6" style="font-family: var(--font-display); letter-spacing: -0.03em;">
        Hola, soy<br>
        <span class="gradient-text">Adrian Arroyo</span>
      </h1>

      <p class="text-lg md:text-xl mb-12 max-w-xl leading-relaxed" style="color: var(--color-text-secondary); font-weight: 300;">
        Construyo software que escala, automatizo lo que otros hacen a mano, y colaboro con IA para ir mas rapido y mas lejos.
      </p>

      <!-- Terminal -->
      <Terminal client:load />

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
        <span class="text-[10px] uppercase tracking-[0.3em] text-white/20" style="font-family: var(--font-mono);">scroll</span>
        <div class="w-px h-8 relative overflow-hidden">
          <div class="w-full h-full bg-gradient-to-b from-[#00f0ff] to-transparent animate-bounce"></div>
        </div>
      </div>
    </div>
  </header>

  <!-- Neural divider -->
  <div class="neural-divider" aria-hidden="true"></div>

  <main>
    <AiSection />
    <div class="neural-divider" aria-hidden="true"></div>
    <StackSection />
    <div class="neural-divider" aria-hidden="true"></div>
    <ProjectsSection />
    <div class="neural-divider" aria-hidden="true"></div>
    <ExperienceSection />
    <div class="neural-divider" aria-hidden="true"></div>
    <GitHubSection />
    <div class="neural-divider" aria-hidden="true"></div>
    <ContactSection />
  </main>

  <!-- Footer -->
  <footer class="relative text-center py-16 border-t" style="border-color: rgba(0,240,255,0.06);">
    <p class="text-sm" style="color: var(--color-text-secondary); font-family: var(--font-body);">
      Disenado y desarrollado por <span class="gradient-text font-semibold">Adrian Arroyo Perez</span>
    </p>
    <p class="text-xs mt-3" style="color: var(--color-text-muted); font-family: var(--font-mono);">
      Astro + React + Three.js + Claude Code
    </p>
    <div class="flex justify-center gap-4 mt-6">
      <div class="w-1 h-1 rounded-full bg-[#00f0ff] opacity-40"></div>
      <div class="w-1 h-1 rounded-full bg-[#39ff14] opacity-40"></div>
      <div class="w-1 h-1 rounded-full bg-[#bf5af2] opacity-40"></div>
    </div>
  </footer>
</Layout>
