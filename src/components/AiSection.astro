---
---

<section id="ai" class="py-24 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="reveal" id="ai-section-inner">

      <!-- Header -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">
          <span data-i18n="ai.title.pre">Powered by </span><span class="gradient-text" data-i18n="ai.title.highlight">AI</span>
        </h2>
        <p class="text-lg" style="color: var(--color-text-secondary);" data-i18n="ai.subtitle">
          La IA no es una herramienta mas en mi stack. Es mi copiloto.
        </p>
      </div>

      <!-- Metrics row -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-20">

        <div class="card p-6 text-center">
          <div class="text-5xl font-bold gradient-text mb-2">5+</div>
          <div class="font-bold text-base mb-1" style="color: var(--color-text-primary);" data-i18n="ai.metric1.label">Skills publicados</div>
          <div class="text-sm" style="color: var(--color-text-muted);" data-i18n="ai.metric1.sub">en Claude Marketplace</div>
        </div>

        <div class="card p-6 text-center">
          <div class="text-5xl font-bold gradient-text mb-2">10+</div>
          <div class="font-bold text-base mb-1" style="color: var(--color-text-primary);" data-i18n="ai.metric2.label">Pipelines automatizados</div>
          <div class="text-sm" style="color: var(--color-text-muted);" data-i18n="ai.metric2.sub">con asistencia IA</div>
        </div>

        <div class="card p-6 text-center">
          <div class="text-5xl font-bold gradient-text mb-2">100%</div>
          <div class="font-bold text-base mb-1" style="color: var(--color-text-primary);" data-i18n="ai.metric3.label">AI-First workflow</div>
          <div class="text-sm" style="color: var(--color-text-muted);" data-i18n="ai.metric3.sub">desde ideacion hasta deploy</div>
        </div>

      </div>

      <!-- Timeline -->
      <div class="mb-20">
        <div class="relative pl-8 border-l-2" style="border-image: linear-gradient(to bottom, var(--color-green), var(--color-blue), var(--color-purple)) 1;">

          <!-- Item 1 -->
          <div class="mb-12 relative">
            <div class="absolute -left-[41px] top-1 w-4 h-4 rounded-full border-2 border-current" style="background: var(--color-green); border-color: var(--color-green); box-shadow: 0 0 8px rgba(0,255,136,0.5);"></div>
            <div class="text-xs font-mono mb-1" style="color: var(--color-green);" data-i18n="ai.timeline1.date">2025 Q4</div>
            <h3 class="text-lg font-bold mb-1" style="color: var(--color-text-primary);" data-i18n="ai.timeline1.title">Primeros pasos con Claude Code</h3>
            <p style="color: var(--color-text-secondary);" data-i18n="ai.timeline1.desc">Automatizacion de tareas DevOps basicas</p>
          </div>

          <!-- Item 2 -->
          <div class="mb-12 relative">
            <div class="absolute -left-[41px] top-1 w-4 h-4 rounded-full" style="background: var(--color-green); box-shadow: 0 0 8px rgba(0,255,136,0.5);"></div>
            <div class="text-xs font-mono mb-1" style="color: var(--color-green);" data-i18n="ai.timeline2.date">2025 Q1</div>
            <h3 class="text-lg font-bold mb-1" style="color: var(--color-text-primary);" data-i18n="ai.timeline2.title">MCP Servers &amp; Custom Skills</h3>
            <p style="color: var(--color-text-secondary);" data-i18n="ai.timeline2.desc">Desarrollo de servidores MCP para Azure DevOps y herramientas custom</p>
          </div>

          <!-- Item 3 -->
          <div class="mb-12 relative">
            <div class="absolute -left-[41px] top-1 w-4 h-4 rounded-full" style="background: var(--color-green); box-shadow: 0 0 8px rgba(0,255,136,0.5);"></div>
            <div class="text-xs font-mono mb-1" style="color: var(--color-green);" data-i18n="ai.timeline3.date">2025 Q2</div>
            <h3 class="text-lg font-bold mb-1" style="color: var(--color-text-primary);" data-i18n="ai.timeline3.title">AI-Driven DevOps</h3>
            <p style="color: var(--color-text-secondary);" data-i18n="ai.timeline3.desc">Reportes OWASP con IA, analisis Kibana automatizado, skills en marketplace</p>
          </div>

          <!-- Item 4 -->
          <div class="relative">
            <div class="absolute -left-[41px] top-1 w-4 h-4 rounded-full" style="background: var(--color-green); box-shadow: 0 0 8px rgba(0,255,136,0.5);"></div>
            <div class="text-xs font-mono mb-1" style="color: var(--color-green);" data-i18n="ai.timeline4.date">2025 Q3</div>
            <h3 class="text-lg font-bold mb-1" style="color: var(--color-text-primary);" data-i18n="ai.timeline4.title">Full AI Engineering</h3>
            <p style="color: var(--color-text-secondary);" data-i18n="ai.timeline4.desc">Portfolio, trading bots y apps completas construidas con Claude Code</p>
          </div>

        </div>
      </div>

      <!-- Quote block -->
      <blockquote class="card p-8 text-center relative overflow-hidden">
        <div class="absolute inset-0 opacity-5" style="background: linear-gradient(135deg, var(--color-green), var(--color-blue), var(--color-purple));"></div>
        <span class="text-6xl leading-none font-serif absolute top-4 left-6 opacity-20" style="color: var(--color-green);">&ldquo;</span>
        <p class="text-lg md:text-xl italic leading-relaxed relative z-10" style="color: var(--color-text-primary);" data-i18n="ai.quote">
          I believe the developers who will thrive are those who learn to collaborate with AI &mdash; not just use it, but think with it.
        </p>
        <span class="text-6xl leading-none font-serif absolute bottom-0 right-6 opacity-20" style="color: var(--color-blue);">&rdquo;</span>
      </blockquote>

    </div>
  </div>
</section>

<script>
  const el = document.getElementById('ai-section-inner');
  if (el) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          observer.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    observer.observe(el);
  }
</script>
