---
const categories = [
  {
    name: "Backend",
    color: "#00f0ff",
    items: [
      { name: "Java", icon: "coffee" },
      { name: "Spring Boot", icon: "leaf" },
      { name: "Python", icon: "code" },
      { name: "SQL", icon: "database" },
    ]
  },
  {
    name: "Frontend",
    color: "#bf5af2",
    items: [
      { name: "React", icon: "atom" },
      { name: "JavaScript", icon: "brackets" },
      { name: "Kotlin", icon: "diamond" },
      { name: "Three.js", icon: "cube" },
    ]
  },
  {
    name: "DevOps & Tools",
    color: "#39ff14",
    items: [
      { name: "Docker", icon: "box" },
      { name: "Azure DevOps", icon: "cloud" },
      { name: "Git", icon: "branch" },
      { name: "Linux", icon: "terminal" },
    ]
  },
  {
    name: "AI / LLM",
    color: "#ff2d78",
    items: [
      { name: "Claude AI", icon: "brain" },
      { name: "MCP Servers", icon: "network" },
      { name: "Playwright", icon: "play" },
      { name: "Custom Skills", icon: "wand" },
    ]
  },
];
---

<section id="stack" class="reveal py-28 px-6 relative">
  <!-- Background accent -->
  <div class="absolute bottom-0 left-0 w-80 h-80 rounded-full opacity-8 pointer-events-none"
       style="background: radial-gradient(circle, #39ff14, transparent 70%); filter: blur(120px); animation: breathe 12s ease-in-out infinite;"></div>

  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-20">
      <span class="inline-block px-3 py-1 mb-4 text-[10px] uppercase tracking-[0.3em] rounded-full border"
            style="font-family: var(--font-mono); color: #39ff14; border-color: rgba(57,255,20,0.2); background: rgba(57,255,20,0.05);">
        Tecnologias
      </span>
      <h2 class="section-title text-4xl md:text-6xl mb-5">
        Mi <span class="gradient-text">Stack</span>
      </h2>
      <p class="section-subtitle text-lg">
        Red neuronal de tecnologias con las que trabajo dia a dia
      </p>
    </div>

    <!-- Category clusters -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {categories.map((cat) => (
        <div class="card p-8 group">
          <!-- Category header -->
          <div class="flex items-center gap-3 mb-6">
            <div class="w-2 h-2 rounded-full" style={`background: ${cat.color}; box-shadow: 0 0 10px ${cat.color}60;`}></div>
            <h3 class="text-sm uppercase tracking-[0.2em] font-semibold"
                style={`color: ${cat.color}; font-family: var(--font-mono);`}>
              {cat.name}
            </h3>
            <div class="flex-1 h-px opacity-20" style={`background: ${cat.color};`}></div>
          </div>

          <!-- Tech items as neural nodes -->
          <div class="grid grid-cols-2 gap-4">
            {cat.items.map((item, i) => (
              <div class="flex items-center gap-3 p-3 rounded-xl transition-all duration-300 hover:bg-white/[0.03] group/item">
                <!-- Neural node -->
                <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 transition-all duration-300 group-hover/item:scale-110"
                     style={`background: ${cat.color}08; border: 1px solid ${cat.color}20;`}>
                  <div class="w-2 h-2 rounded-full transition-all duration-300 group-hover/item:shadow-lg"
                       style={`background: ${cat.color}; box-shadow: 0 0 6px ${cat.color}40;`}></div>
                </div>
                <span class="text-sm font-medium" style="color: var(--color-text-primary); font-family: var(--font-body);">
                  {item.name}
                </span>
              </div>
            ))}
          </div>

          <!-- Decorative synapse line at bottom -->
          <div class="mt-6 h-px w-full opacity-0 group-hover:opacity-30 transition-opacity duration-500"
               style={`background: linear-gradient(90deg, transparent, ${cat.color}, transparent);`}></div>
        </div>
      ))}
    </div>
  </div>
</section>
