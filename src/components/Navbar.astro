---
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 md:px-12 transition-all duration-500"
  style="height: 72px; background: rgba(6, 6, 18, 0.6); backdrop-filter: blur(20px) saturate(1.4);"
>
  <!-- Logo with neural pulse -->
  <a href="/" class="flex items-center shrink-0 select-none group">
    <span class="relative">
      <span class="font-mono text-xl font-bold text-white/80 group-hover:text-white transition-colors">&lt;</span>
      <span
        class="font-mono text-xl font-extrabold gradient-text"
        style="font-family: var(--font-display);"
      >AA</span>
      <span class="font-mono text-xl font-bold text-white/80 group-hover:text-white transition-colors">/&gt;</span>
      <!-- Neural glow on hover -->
      <span class="absolute -inset-2 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10"
            style="background: radial-gradient(circle, rgba(0,240,255,0.15) 0%, transparent 70%);"></span>
    </span>
  </a>

  <!-- Desktop nav links -->
  <ul class="hidden md:flex items-center gap-8 text-sm font-medium tracking-wide" style="font-family: var(--font-body);">
    {[
      { label: "AI",         href: "#ai"         },
      { label: "Stack",      href: "#stack"      },
      { label: "Proyectos",  href: "#projects"   },
      { label: "Trayectoria", href: "#experience" },
      { label: "Contacto",   href: "#contact"    },
    ].map(({ label, href }) => (
      <li>
        <a
          href={href}
          class="nav-link text-white/50 hover:text-[#00f0ff] transition-all duration-300 relative py-1"
        >
          {label}
        </a>
      </li>
    ))}
  </ul>

  <!-- Right side -->
  <div class="flex items-center gap-3">
    <!-- CTA button -->
    <a
      href="#contact"
      class="hidden md:inline-flex items-center gap-2 px-5 py-2 rounded-full text-xs font-semibold tracking-wider uppercase transition-all duration-300 border"
      style="border-color: rgba(0,240,255,0.3); color: #00f0ff; background: rgba(0,240,255,0.05);"
      onmouseenter="this.style.background='rgba(0,240,255,0.15)'; this.style.boxShadow='0 0 20px rgba(0,240,255,0.2)'"
      onmouseleave="this.style.background='rgba(0,240,255,0.05)'; this.style.boxShadow='none'"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-[#39ff14] animate-pulse"></span>
      Hablemos
    </a>

    <!-- Hamburger (mobile) -->
    <button
      id="hamburger"
      class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 rounded-xl transition-colors duration-200 cursor-pointer"
      style="border: 1px solid rgba(0,240,255,0.15); background: rgba(0,240,255,0.03);"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span class="hamburger-line block w-5 h-px transition-all duration-300 origin-center" style="background: #00f0ff;"></span>
      <span class="hamburger-line block w-5 h-px transition-all duration-300 origin-center" style="background: #00f0ff;"></span>
      <span class="hamburger-line block w-5 h-px transition-all duration-300 origin-center" style="background: #00f0ff;"></span>
    </button>
  </div>
</nav>

<!-- Mobile fullscreen overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 flex flex-col items-center justify-center opacity-0 pointer-events-none transition-opacity duration-400"
  style="background: rgba(6, 6, 18, 0.97); backdrop-filter: blur(30px);"
  aria-hidden="true"
>
  <ul class="flex flex-col items-center gap-8 text-center">
    {[
      { label: "AI",         href: "#ai"         },
      { label: "Stack",      href: "#stack"      },
      { label: "Proyectos",  href: "#projects"   },
      { label: "Trayectoria", href: "#experience" },
      { label: "Contacto",   href: "#contact"    },
    ].map(({ label, href }) => (
      <li>
        <a
          href={href}
          class="mobile-nav-link text-3xl font-bold text-white/70 hover:text-[#00f0ff] transition-colors duration-200"
          style="font-family: var(--font-display);"
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, #00f0ff, #39ff14);
    transition: width 0.3s ease;
  }
  .nav-link:hover::after {
    width: 100%;
  }

  #navbar.scrolled {
    background: rgba(6, 6, 18, 0.92) !important;
    box-shadow:
      0 1px 0 rgba(0, 240, 255, 0.06),
      0 8px 40px rgba(0, 0, 0, 0.5);
  }
</style>

<script>
  const navbar = document.getElementById("navbar");
  function handleScroll() {
    if (!navbar) return;
    navbar.classList.toggle("scrolled", window.scrollY > 50);
  }
  window.addEventListener("scroll", handleScroll, { passive: true });
  handleScroll();

  const hamburger = document.getElementById("hamburger");
  const mobileMenu = document.getElementById("mobile-menu");
  const hamburgerLines = document.querySelectorAll<HTMLElement>(".hamburger-line");
  const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");
  let menuOpen = false;

  function openMenu() {
    menuOpen = true;
    hamburger?.setAttribute("aria-expanded", "true");
    mobileMenu?.classList.remove("opacity-0", "pointer-events-none");
    mobileMenu?.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    if (hamburgerLines[0]) hamburgerLines[0].style.transform = "translateY(5px) rotate(45deg)";
    if (hamburgerLines[1]) { hamburgerLines[1].style.opacity = "0"; hamburgerLines[1].style.transform = "scaleX(0)"; }
    if (hamburgerLines[2]) hamburgerLines[2].style.transform = "translateY(-9px) rotate(-45deg)";
  }

  function closeMenu() {
    menuOpen = false;
    hamburger?.setAttribute("aria-expanded", "false");
    mobileMenu?.classList.add("opacity-0", "pointer-events-none");
    mobileMenu?.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    hamburgerLines.forEach((line) => { line.style.transform = ""; line.style.opacity = ""; });
  }

  hamburger?.addEventListener("click", () => { menuOpen ? closeMenu() : openMenu(); });
  mobileNavLinks.forEach((link) => { link.addEventListener("click", closeMenu); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && menuOpen) closeMenu(); });
</script>
