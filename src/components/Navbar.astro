---
import LanguageToggle from '../i18n/LanguageToggle.tsx';
const navItems = [
  { key: "nav.about",      label: "Sobre mí",     href: "#about"      },
  { key: "nav.stack",      label: "Stack",         href: "#stack"      },
  { key: "nav.projects",   label: "Proyectos",     href: "#projects"   },
  { key: "nav.ai",         label: "IA",            href: "#ai"         },
  { key: "nav.experience", label: "Experiencia",   href: "#experience" },
  { key: "nav.contact",    label: "Contacto",      href: "#contact"    },
];
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 h-18 flex items-center justify-between px-6 md:px-12
         bg-[#0a0a0f]/85 backdrop-blur-md border-b border-white/[0.06] transition-all duration-300"
  style="height: 72px;"
>
  <a href="/" class="flex items-center shrink-0 select-none">
    <span class="font-mono text-xl font-bold text-white">&lt;</span>
    <span class="font-mono text-xl font-bold bg-gradient-to-r from-[#00ff88] to-[#00aaff] bg-clip-text text-transparent">AA</span>
    <span class="font-mono text-xl font-bold text-white">/&gt;</span>
  </a>

  <ul class="hidden md:flex items-center gap-8 text-sm font-medium tracking-wide">
    {navItems.map(({ key, label, href }) => (
      <li>
        <a
          href={href}
          data-i18n={key}
          class="text-white/70 hover:text-[#00ff88] transition-colors duration-200 relative
                 after:absolute after:left-0 after:-bottom-0.5 after:h-px after:w-0
                 after:bg-[#00ff88] after:transition-all after:duration-200
                 hover:after:w-full"
        >
          {label}
        </a>
      </li>
    ))}
  </ul>

  <div class="flex items-center gap-3">
    <div class="hidden md:block">
      <LanguageToggle client:load />
    </div>
    <button
      id="hamburger"
      class="md:hidden flex flex-col justify-center items-center w-9 h-9 gap-1.5
             rounded-md border border-white/10 hover:border-white/30 transition-colors duration-200 cursor-pointer"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span class="hamburger-line block w-5 h-px bg-white/80 transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-5 h-px bg-white/80 transition-all duration-300 origin-center"></span>
      <span class="hamburger-line block w-5 h-px bg-white/80 transition-all duration-300 origin-center"></span>
    </button>
  </div>
</nav>

<div
  id="mobile-menu"
  class="fixed inset-0 z-40 bg-[#0a0a0f]/97 backdrop-blur-xl flex flex-col items-center justify-center
         opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
>
  <ul class="flex flex-col items-center gap-8 text-center">
    {navItems.map(({ key, label, href }) => (
      <li>
        <a
          href={href}
          data-i18n={key}
          class="mobile-nav-link text-3xl font-semibold text-white/80 hover:text-[#00ff88]
                 transition-colors duration-200 tracking-wide"
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
  <div class="mt-12">
    <LanguageToggle client:load />
  </div>
</div>

<script>
  const navbar = document.getElementById("navbar");
  function handleScroll() {
    if (!navbar) return;
    navbar.classList.toggle("scrolled", window.scrollY > 50);
  }
  window.addEventListener("scroll", handleScroll, { passive: true });
  handleScroll();

  const hamburger = document.getElementById("hamburger");
  const mobileMenu = document.getElementById("mobile-menu");
  const hamburgerLines = document.querySelectorAll<HTMLElement>(".hamburger-line");
  const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");
  let menuOpen = false;

  function openMenu() {
    menuOpen = true;
    hamburger?.setAttribute("aria-expanded", "true");
    mobileMenu?.classList.remove("opacity-0", "pointer-events-none");
    mobileMenu?.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    if (hamburgerLines[0]) hamburgerLines[0].style.transform = "translateY(5px) rotate(45deg)";
    if (hamburgerLines[1]) { hamburgerLines[1].style.opacity = "0"; hamburgerLines[1].style.transform = "scaleX(0)"; }
    if (hamburgerLines[2]) hamburgerLines[2].style.transform = "translateY(-9px) rotate(-45deg)";
  }

  function closeMenu() {
    menuOpen = false;
    hamburger?.setAttribute("aria-expanded", "false");
    mobileMenu?.classList.add("opacity-0", "pointer-events-none");
    mobileMenu?.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    hamburgerLines.forEach((line) => { line.style.transform = ""; line.style.opacity = ""; });
  }

  hamburger?.addEventListener("click", () => { menuOpen ? closeMenu() : openMenu(); });
  mobileNavLinks.forEach((link) => { link.addEventListener("click", closeMenu); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && menuOpen) closeMenu(); });
</script>

<style>
  #navbar.scrolled {
    box-shadow: 0 4px 32px rgba(0, 0, 0, 0.45);
    background-color: rgba(10, 10, 15, 0.95);
  }
</style>
