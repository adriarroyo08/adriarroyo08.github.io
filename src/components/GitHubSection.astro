---
import GitHubActivity from './GitHubActivity.tsx';
---

<section id="github" class="py-16 sm:py-20 md:py-28 px-4 sm:px-6">
  <div class="max-w-5xl mx-auto reveal">
    <div class="text-center mb-10 sm:mb-16">
      <span class="inline-block px-3 py-1 mb-3 sm:mb-4 text-[10px] uppercase tracking-[0.3em] rounded-full border"
            style="font-family: var(--font-mono); color: #39ff14; border-color: rgba(57,255,20,0.2); background: rgba(57,255,20,0.05);">
        Open Source
      </span>
      <h2 class="section-title text-3xl sm:text-4xl md:text-6xl mb-3 sm:mb-5">
        Actividad en <span class="gradient-text">GitHub</span>
      </h2>
      <p class="section-subtitle text-sm sm:text-lg">Lo que estoy construyendo ahora mismo</p>
    </div>
    <GitHubActivity client:visible />
  </div>
</section>
