  {
    label: "Email",
    value: "adriarroyo2002@gmail.com",
    href: "mailto:adriarroyo2002@gmail.com",
    color: "#00f0ff",
    icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="2" y="4" width="18" height="14" rx="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
      <path d="M2 7 L11 13 L20 7" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`,
  },
  {
    label: "LinkedIn",
