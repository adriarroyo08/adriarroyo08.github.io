---

<section id="contact" class="reveal py-24 px-6 max-w-4xl mx-auto">
  <div class="text-center mb-16">
    <h2 class="text-4xl font-bold mb-4">
      Hablemos<span class="gradient-text">.</span>
    </h2>
    <p class="text-zinc-400 text-lg">Interesado en trabajar juntos?</p>
  </div>

  <div class="flex flex-wrap justify-center gap-4">
    {contacts.map((contact) => (
      <a
        href={contact.href}
        target={contact.download ? "_self" : "_blank"}
        rel={contact.download ? undefined : "noopener noreferrer"}
        download={contact.download ? true : undefined}
        class="contact-card card flex items-center gap-4 px-6 py-5 min-w-[220px] group"
      >
        <span class="text-emerald-400 group-hover:scale-110 transition-transform duration-200 flex-shrink-0" set:html={contact.icon} />
        <div>
          <p class="text-xs text-zinc-500 uppercase tracking-wider mb-0.5">{contact.label}</p>
          <p class="text-sm font-medium text-zinc-200 group-hover:text-emerald-400 transition-colors duration-200">
            {contact.value}
          </p>
        </div>
      </a>
    ))}
  </div>

  <p class="text-center text-zinc-600 text-sm mt-16">
    Hecho con Astro &amp; Three.js &mdash; {new Date().getFullYear()}
  </p>
</section>

<style>
  .contact-card {
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .contact-card:hover {
    transform: translateY(-2px);
  }
</style>
