    color: "#bf5af2",
    icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M11 2 C6.03 2 2 6.03 2 11 C2 14.97 4.67 18.35 8.36 19.54 C8.81 19.62 8.97 19.35 8.97 19.11 C8.97 18.9 8.96 18.19 8.96 17.44 C6.6 17.87 6.06 16.9 5.88 16.39 C5.78 16.13 5.35 15.34 4.97 15.13 C4.66 14.96 4.21 14.53 4.96 14.52 C5.66 14.51 6.16 15.17 6.33 15.44 C7.13 16.78 8.39 16.39 9 16.15 C9.08 15.57 9.31 15.17 9.57 14.95 C7.6 14.73 5.54 13.97 5.54 10.58 C5.54 9.61 5.88 8.81 6.35 8.18 C6.26 7.96 5.95 7.04 6.44 5.81 C6.44 5.81 7.18 5.57 8.97 6.72 C9.68 6.52 10.44 6.42 11.2 6.42 C11.96 6.42 12.72 6.52 13.43 6.72 C15.22 5.56 15.96 5.81 15.96 5.81 C16.45 7.04 16.14 7.96 16.05 8.18 C16.52 8.81 16.86 9.6 16.86 10.58 C16.86 13.98 14.79 14.73 12.82 14.95 C13.14 15.22 13.42 15.76 13.42 16.59 C13.42 17.78 13.41 18.74 13.41 19.11 C13.41 19.35 13.57 19.63 14.02 19.54 C17.33 18.35 20 14.96 20 11 C20 6.03 15.97 2 11 2Z" fill="currentColor"/>
