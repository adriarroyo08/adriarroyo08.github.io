---
const projects = [
  {
    title: "Login Abstracto",
    type: "profesional",
    description: "Sistema de autenticacion centralizado reutilizable",
    tags: ["Java", "Spring", "SSO"],
  },
  {
    title: "CI/CD Pipelines",
    type: "profesional",
    description: "Automatizacion completa en Azure DevOps",
    tags: ["Azure DevOps", "YAML", "CI/CD"],
  },
  {
    title: "Testing E2E",
    type: "profesional",
    description: "Framework Playwright para matriculacion",
    tags: ["Playwright", "QA", "Spring Boot"],
  },
  {
    title: "AI DevOps",
    type: "profesional",
    description: "Skills y MCPs para automatizacion con IA",
    tags: ["Claude AI", "MCP", "Automation"],
  },
  {
    title: "PetWatch",
    type: "personal",
    description: "Juego v-pet Pokemon para WearOS y movil",
    tags: ["Kotlin", "WearOS", "Gaming"],
  },
  {
    title: "AhorrApp",
    type: "personal",
    description: "Comparador de precios de supermercados",
    tags: ["React Native", "Python", "FastAPI"],
  },
  {
    title: "Trading Bot",
    type: "personal",
    description: "Bot de trading automatizado con IA",
    tags: ["Python", "Freqtrade", "Telegram"],
  },
];
---

<section id="projects" class="reveal py-24 px-6 max-w-6xl mx-auto">
  <div class="text-center mb-12">
    <h2 class="text-4xl font-bold mb-4">
      Mis <span class="gradient-text">Proyectos</span>
    </h2>
    <p class="text-zinc-400 text-lg">Una seleccion de lo que he construido</p>
  </div>

  <!-- Filter buttons -->
  <div class="flex justify-center gap-3 mb-12 flex-wrap">
    <button
      class="filter-btn active px-5 py-2 rounded-full text-sm font-medium transition-all duration-200"
      data-filter="todos"
    >
      Todos
    </button>
    <button
      class="filter-btn px-5 py-2 rounded-full text-sm font-medium transition-all duration-200"
      data-filter="profesional"
    >
      Profesional
    </button>
    <button
      class="filter-btn px-5 py-2 rounded-full text-sm font-medium transition-all duration-200"
      data-filter="personal"
    >
      Personal
    </button>
  </div>

  <!-- Projects grid -->
  <div class="grid gap-6" style="grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));">
    {projects.map((project) => (
      <div
        class="card project-card p-6 flex flex-col gap-4"
        data-type={project.type}
      >
        <!-- Type badge -->
        <div>
          {project.type === "profesional" ? (
            <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/15 text-blue-400 border border-blue-500/25">
              Profesional
            </span>
          ) : (
            <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-purple-500/15 text-purple-400 border border-purple-500/25">
              Personal
            </span>
          )}
        </div>

        <!-- Title -->
        <h3 class="text-xl font-bold text-zinc-100">{project.title}</h3>

        <!-- Description -->
        <p class="text-sm text-zinc-400 leading-relaxed flex-1">{project.description}</p>

        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mt-auto">
          {project.tags.map((tag) => (
            <span class="px-2 py-1 rounded text-xs text-zinc-400 bg-zinc-800 border border-zinc-700">
              {tag}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .filter-btn {
    background: transparent;
    border: 1px solid rgb(63 63 70);
    color: rgb(161 161 170);
    cursor: pointer;
  }

  .filter-btn:hover {
    border-color: rgb(52 211 153);
    color: rgb(52 211 153);
  }

  .filter-btn.active {
    background: linear-gradient(135deg, #00dc82, #36e4da);
    border-color: transparent;
    color: #0a0a0a;
  }

  .project-card {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .project-card.hidden {
    display: none;
  }
</style>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;

      // Update active button
      filterButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      // Show/hide cards
      projectCards.forEach((card) => {
        const type = card.dataset.type;
        if (filter === 'todos' || type === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>
