---
const projects = [
  {
    title: "Login Abstracto",
    type: "profesional",
    description: "Sistema de autenticacion centralizado reutilizable para multiples aplicaciones universitarias con SSO integrado.",
    tags: ["Java", "Spring", "SSO"],
    accent: "#00f0ff",
  },
  {
    title: "CI/CD Pipelines",
    type: "profesional",
    description: "Automatizacion completa del ciclo de vida del software en Azure DevOps con deploys zero-downtime.",
    tags: ["Azure DevOps", "YAML", "CI/CD"],
    accent: "#39ff14",
  },
  {
    title: "Testing E2E",
    type: "profesional",
    description: "Framework Playwright para testing automatizado de matriculacion con cobertura completa.",
    tags: ["Playwright", "QA", "Spring Boot"],
    accent: "#bf5af2",
  },
  {
    title: "AI DevOps",
    type: "profesional",
    description: "Skills y MCPs para automatizacion de DevOps con IA — reportes OWASP, analisis Kibana, workflows inteligentes.",
    tags: ["Claude AI", "MCP", "Automation"],
    accent: "#ff2d78",
  },
  {
    title: "PetWatch",
    type: "personal",
    description: "Juego v-pet Pokemon para WearOS y movil con sistema de cuidados, batallas y evolucion en tiempo real.",
    tags: ["Kotlin", "WearOS", "Gaming"],
    accent: "#ff6b35",
  },
  {
    title: "AhorrApp",
    type: "personal",
    description: "Comparador de precios de supermercados espanoles con scraping automatizado y alertas inteligentes.",
    tags: ["React Native", "Python", "FastAPI"],
    accent: "#00f0ff",
  },
  {
    title: "Trading Bot",
    type: "personal",
    description: "Bot de trading automatizado con estrategias basadas en indicadores tecnicos y senales por Telegram.",
    tags: ["Python", "Freqtrade", "Telegram"],
    accent: "#39ff14",
  },
];
---

<section id="projects" class="reveal py-28 px-6 relative">
  <div class="absolute top-20 right-0 w-72 h-72 rounded-full opacity-8 pointer-events-none"
       style="background: radial-gradient(circle, #bf5af2, transparent 70%); filter: blur(100px); animation: breathe 9s ease-in-out infinite;"></div>

  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <span class="inline-block px-3 py-1 mb-4 text-[10px] uppercase tracking-[0.3em] rounded-full border"
            style="font-family: var(--font-mono); color: #bf5af2; border-color: rgba(191,90,242,0.2); background: rgba(191,90,242,0.05);">
        Portfolio
      </span>
      <h2 class="section-title text-4xl md:text-6xl mb-5">
        Mis <span class="gradient-text">Proyectos</span>
      </h2>
      <p class="section-subtitle text-lg">Una seleccion de lo que he construido</p>
    </div>

    <!-- Filter buttons -->
    <div class="flex justify-center gap-3 mb-14 flex-wrap">
      {["todos", "profesional", "personal"].map((filter) => (
        <button
          class={`filter-btn px-6 py-2.5 rounded-full text-xs font-semibold uppercase tracking-[0.15em] transition-all duration-300 cursor-pointer ${filter === 'todos' ? 'active' : ''}`}
          data-filter={filter}
          style="font-family: var(--font-mono);"
        >
          {filter === 'todos' ? 'Todos' : filter === 'profesional' ? 'Profesional' : 'Personal'}
        </button>
      ))}
    </div>

    <!-- Projects grid -->
    <div class="grid gap-6" style="grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));">
      {projects.map((project) => (
        <div
          class="card project-card p-7 flex flex-col gap-5 group"
          data-type={project.type}
        >
          <!-- Top accent line -->
          <div class="h-px w-16 rounded-full transition-all duration-500 group-hover:w-full"
               style={`background: ${project.accent};`}></div>

          <!-- Type badge -->
          <div>
            {project.type === "profesional" ? (
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-semibold uppercase tracking-wider"
                    style="background: rgba(0,240,255,0.08); color: #00f0ff; border: 1px solid rgba(0,240,255,0.15);">
                <span class="w-1 h-1 rounded-full bg-[#00f0ff]"></span>
                Profesional
              </span>
            ) : (
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-semibold uppercase tracking-wider"
                    style="background: rgba(191,90,242,0.08); color: #bf5af2; border: 1px solid rgba(191,90,242,0.15);">
                <span class="w-1 h-1 rounded-full bg-[#bf5af2]"></span>
                Personal
              </span>
            )}
          </div>

          <!-- Title -->
          <h3 class="text-xl font-bold" style="font-family: var(--font-display); color: var(--color-text-primary);">
            {project.title}
          </h3>

          <!-- Description -->
          <p class="text-sm leading-relaxed flex-1" style="color: var(--color-text-secondary);">
            {project.description}
          </p>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2 mt-auto">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .filter-btn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--color-text-muted);
  }

  .filter-btn:hover {
    border-color: rgba(0, 240, 255, 0.3);
    color: #00f0ff;
    background: rgba(0, 240, 255, 0.04);
  }

  .filter-btn.active {
    background: linear-gradient(135deg, rgba(0, 240, 255, 0.15), rgba(57, 255, 20, 0.1));
    border-color: rgba(0, 240, 255, 0.3);
    color: #00f0ff;
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.08);
  }

  .project-card {
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .project-card.hidden {
    display: none;
  }
</style>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      filterButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      projectCards.forEach((card) => {
        const type = card.dataset.type;
        if (filter === 'todos' || type === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>
