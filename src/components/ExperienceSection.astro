---
const timeline = [
  {
    period: "Oct 2024 — Actualidad",
    title: "Desarrollador Fullstack",
    description: "Entorno universitario — Desarrollo web con Java, Spring Boot y ZK Framework. CI/CD, testing E2E, y automatizacion con IA.",
    color: "#00f0ff",
    active: true,
  },
  {
    period: "2024",
    title: "TFG: Testing E2E con Playwright",
    description: "Framework de testing automatizado de extremo a extremo para procesos de matriculacion universitaria.",
    color: "#39ff14",
  },
  {
    period: "2020 — 2024",
    title: "Grado en Ingenieria Informatica",
    description: "Universidad de Cordoba — Especializacion en desarrollo de software, algoritmos y sistemas distribuidos.",
    color: "#bf5af2",
  },
  {
    period: "2018 — 2020",
    title: "Bachillerato",
    description: "IES Luis de Gongora, Cordoba — Ciencias y Tecnologia.",
    color: "#ff2d78",
  },
];
---

<section id="experience" class="reveal py-16 sm:py-20 md:py-28 px-4 sm:px-6 relative">
  <div class="absolute top-0 left-0 w-64 h-64 rounded-full opacity-8 pointer-events-none"
       style="background: radial-gradient(circle, #ff2d78, transparent 70%); filter: blur(100px); animation: breathe 11s ease-in-out infinite;"></div>

  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12 sm:mb-16 md:mb-20">
      <span class="inline-block px-3 py-1 mb-3 sm:mb-4 text-[10px] uppercase tracking-[0.3em] rounded-full border"
            style="font-family: var(--font-mono); color: #ff2d78; border-color: rgba(255,45,120,0.2); background: rgba(255,45,120,0.05);">
        Experiencia
      </span>
      <h2 class="section-title text-3xl sm:text-4xl md:text-6xl mb-3 sm:mb-5">
        Mi <span class="gradient-text-alt">Trayectoria</span>
      </h2>
      <p class="section-subtitle text-sm sm:text-lg">El camino recorrido hasta aqui</p>
    </div>

    <div class="relative">
      <!-- Neural pathway line -->
      <div class="absolute left-4 sm:left-6 md:left-8 top-0 bottom-0 w-px"
           style="background: linear-gradient(to bottom, #00f0ff, #39ff14, #bf5af2, #ff2d78, transparent);"></div>

      <div class="flex flex-col gap-0">
        {timeline.map((item, i) => (
          <div class="relative pl-10 sm:pl-16 md:pl-20 pb-8 sm:pb-14 last:pb-0 group">
            <!-- Neural node with pulse -->
            <div class="absolute left-[10px] sm:left-[18px] md:left-[26px] top-3 z-10">
              <div class="w-2.5 sm:w-3.5 h-2.5 sm:h-3.5 rounded-full transition-all duration-500 group-hover:scale-150"
                   style={`background: ${item.color}; box-shadow: 0 0 12px ${item.color}60, 0 0 24px ${item.color}20; animation: neural-pulse 5s ease-in-out infinite; animation-delay: ${i * 1.2}s;`}>
              </div>
              {item.active && (
                <div class="absolute inset-0 rounded-full animate-ping opacity-40"
                     style={`background: ${item.color};`}></div>
              )}
            </div>

            <!-- Horizontal synapse -->
            <div class="absolute left-[22px] sm:left-[32px] md:left-[40px] top-[17px] sm:top-[18px] w-4 sm:w-8 h-px opacity-20"
                 style={`background: ${item.color};`}></div>

            <!-- Content card -->
            <div class="card p-4 sm:p-5 md:p-7 transition-all duration-400"
                 style={`border-left: 2px solid ${item.color}15;`}>
              <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-2 sm:mb-3">
                <span class="text-[9px] sm:text-[10px] uppercase tracking-[0.2em] sm:tracking-[0.3em] font-medium"
                      style={`color: ${item.color}; font-family: var(--font-mono);`}>{item.period}</span>
                {item.active && (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[8px] sm:text-[9px] uppercase tracking-wider font-semibold"
                        style="background: rgba(0,240,255,0.1); color: #00f0ff; border: 1px solid rgba(0,240,255,0.2);">
                    <span class="w-1 h-1 rounded-full bg-[#39ff14] animate-pulse"></span>
                    Actual
                  </span>
                )}
              </div>
              <h3 class="text-base sm:text-lg font-bold mb-1 sm:mb-2" style="font-family: var(--font-display); color: var(--color-text-primary);">
                {item.title}
              </h3>
              <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--color-text-secondary);">
                {item.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
