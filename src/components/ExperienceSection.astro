---
const timeline = [
  {
    color: "emerald",
    period: "Oct 2024 — Actualidad",
    title: "Desarrollador Fullstack",
    description: "Entorno universitario — Desarrollo web con Java, Spring Boot y ZK Framework",
    dot: "#00dc82",
    glow: "rgba(0, 220, 130, 0.5)",
  },
  {
    color: "blue",
    period: "2024",
    title: "TFG: Testing E2E",
    description: "Framework de testing automatizado con Playwright",
    dot: "#38bdf8",
    glow: "rgba(56, 189, 248, 0.5)",
  },
  {
    color: "blue",
    period: "2020 — 2024",
    title: "Grado en Ingenieria Informatica",
    description: "Universidad de Cordoba",
    dot: "#38bdf8",
    glow: "rgba(56, 189, 248, 0.5)",
  },
  {
    color: "purple",
    period: "2018 — 2020",
    title: "Bachillerato",
    description: "IES Luis de Gongora, Cordoba",
    dot: "#a78bfa",
    glow: "rgba(167, 139, 250, 0.5)",
  },
];
---

<section id="experience" class="reveal py-24 px-6 max-w-4xl mx-auto">
  <div class="text-center mb-16">
    <h2 class="text-4xl font-bold mb-4">
      Mi <span class="gradient-text">Trayectoria</span>
    </h2>
    <p class="text-zinc-400 text-lg">El camino recorrido hasta aqui</p>
  </div>

  <div class="relative">
    <!-- Timeline vertical line -->
    <div class="absolute left-0 top-0 bottom-0 w-0.5 timeline-line"></div>

    <div class="flex flex-col gap-10">
      {timeline.map((item) => (
        <div class="relative pl-8">
          <!-- Dot -->
          <div
            class="absolute left-0 top-1 w-3 h-3 rounded-full -translate-x-[5px]"
            style={`background-color: ${item.dot}; box-shadow: 0 0 8px 2px ${item.glow};`}
          ></div>

          <!-- Content -->
          <div class="card p-5">
            <p class="text-xs font-mono mb-1" style={`color: ${item.dot};`}>
              {item.period}
            </p>
            <h3 class="text-lg font-bold text-zinc-100 mb-1">{item.title}</h3>
            <p class="text-sm text-zinc-400">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline-line {
    background: linear-gradient(
      to bottom,
      #00dc82,
      #38bdf8 50%,
      transparent 100%
    );
  }
</style>
